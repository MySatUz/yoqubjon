generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String?
  passwordHash  String?
  role          UserRole       @default(USER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  results       Result[]
  subscriptions Subscription[]
  payments      Payment[]
  manualPaymentRequests ManualPaymentRequest[]
  sectionAccesses SectionAccess[]
}

model Test {
  id                 String                    @id @default(uuid())
  title              String
  description        String?
  isFree             Boolean                   @default(false)
  visible            Boolean                   @default(true)
  durationSeconds    Int                       @default(7200)
  // One entry per SAT-style module, in order. Empty means a single-module test
  // that runs on durationSeconds alone.
  moduleDurations    Int[]                     @default([])
  maxAttempts        Int                       @default(10)
  collectionCategory String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  collection  TestCollectionVisibility? @relation(fields: [collectionCategory], references: [category], onDelete: SetNull)
  questions   Question[]
  results     Result[]

  @@index([createdAt])
  @@index([collectionCategory])
  @@index([visible])
}

model TestCollectionVisibility {
  category  String   @id
  label     String?
  description String?
  position  Int      @default(0)
  visible   Boolean  @default(true)
  maxAttempts Int    @default(10)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tests     Test[]
  sectionAccesses SectionAccess[]
}

model SectionAccess {
  id          String   @id @default(uuid())
  email       String
  userId      String?
  category    String
  expiresAt   DateTime?
  note        String?
  grantedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  collection  TestCollectionVisibility @relation(fields: [category], references: [category], onDelete: Cascade)

  @@unique([email, category])
  @@index([userId])
  @@index([category])
  @@index([expiresAt])
}

model Question {
  id            String   @id @default(uuid())
  testId        String
  content       String   // The reading passage or question text
  options       Json     // e.g., ["A", "B", "C", "D"] mapping
  correctAnswer String   // e.g., "A"
  explanation   String?  // Text explanation
  videoUrl      String?  // YouTube/Vimeo iframe URL
  imageUrl      String?  // Local path to image
  order         Int      // Question order in the test
  moduleIndex   Int      @default(1) // 1-based module this question belongs to
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  test          Test     @relation(fields: [testId], references: [id])

  @@index([testId, order])
  @@index([testId, moduleIndex, order])
}

model Result {
  id          String   @id @default(uuid())
  userId      String
  testId      String
  score       Int
  timeSpent   Int      // Time spent in seconds
  answers     Json     // User's selected answers
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id])
  test        Test     @relation(fields: [testId], references: [id])

  @@index([userId])
  @@index([userId, createdAt])
  @@index([testId])
}

model Subscription {
  id                     String   @id @default(uuid())
  userId                 String
  planId                 String
  isActive               Boolean  @default(true)
  expiresAt              DateTime
  provider               String   @default("MANUAL")
  providerSubscriptionId String?  @unique
  providerCustomerId     String?
  providerStatus         String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user                   User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, isActive, expiresAt])
}

model SubscriptionSetting {
  id         String   @id @default("global")
  isEnabled  Boolean  @default(true)
  cardHolder String   @default("Abdunazarov Mardon")
  cardNumber String   @default("9860 1201 0243 8112")
  cardType   String   @default("HUMO")
  amount     Int      @default(119000)
  updatedAt  DateTime @updatedAt
}

model Payment {
  id            String   @id @default(uuid())
  userId        String
  amount        Int      // in tiyin/cents
  currency      String   @default("UZS")
  provider      String   // e.g. "MANUAL_TRANSFER" or "MOCK"
  transactionId String?  @unique
  status        String   // "PENDING", "SUCCESS", "FAILED"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([transactionId])
}

model ManualPaymentRequest {
  id               String   @id @default(uuid())
  userId           String
  amount           Int
  currency         String   @default("UZS")
  status           String   @default("PENDING")
  payerName        String?
  contact          String?
  paymentReference String?
  receiptPath      String?
  receiptFileName  String?
  receiptMimeType  String?
  message          String?
  adminNote        String?
  reviewedById     String?
  reviewedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status, createdAt])
}
