generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String?
  passwordHash  String?
  role          UserRole       @default(USER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  results       Result[]
  subscriptions Subscription[]
  payments      Payment[]
  manualPaymentRequests ManualPaymentRequest[]
  sectionAccesses SectionAccess[]
  testCodeUnlocks TestCodeUnlock[]
  emailCodes      EmailCode[]
  pendingEmailVerification PendingEmailVerification?
}

// An account that still has to prove it owns its email address. No row means
// verified: everyone who signed up before verification existed, and everyone
// who has entered their code (the row is deleted then). A table of its own, not
// a column on User, so that no query on users changes shape and an older
// deployment keeps working against a database that already has it.
model PendingEmailVerification {
  userId     String   @id
  // sha256 of a random secret kept in the signing-up browser's httpOnly cookie.
  // A code is only accepted with that secret or with the account's password,
  // so whoever typed someone else's address cannot have the real owner's code
  // confirm an account that carries the stranger's password.
  secretHash String?
  createdAt  DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A one-time six-digit code sent by email, to confirm the address
// ("verify-email") or to set a new password ("reset-password"). Only an HMAC of
// the code is stored. The newest row per user and purpose is the live one;
// older rows stay until it is used, so the hourly sending limit can count them.
model EmailCode {
  id        String   @id @default(uuid())
  userId    String
  purpose   String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
}

// One row per rate-limited auth event (a failed sign-in, a sign-up, a reset
// request), keyed like "login:email:<email>" or "register:ip:<ip>". Kept in
// Postgres because a counter in memory does not survive a new serverless
// instance.
model AuthAttempt {
  id        String   @id @default(uuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model Test {
  id                 String                    @id @default(uuid())
  title              String
  description        String?
  isFree             Boolean                   @default(false)
  visible            Boolean                   @default(true)
  durationSeconds    Int                       @default(7200)
  // One entry per SAT-style module, in order. Empty means a single-module test
  // that runs on durationSeconds alone.
  moduleDurations    Int[]                     @default([])
  maxAttempts        Int                       @default(10)
  // A competition window. Both set means the test runs as an olympiad: it can
  // only be opened between these two instants, and the ranking counts only the
  // attempts started inside them. Either one null means an ordinary test.
  olympiadStartsAt   DateTime?
  olympiadEndsAt     DateTime?
  // Six digits a student must enter once before the test opens, on top of the
  // usual subscription / section access. Null means the test needs no code.
  accessCode         String?
  collectionCategory String?
  // Set on a copy: the test whose questions this one shows. A copy has a title,
  // section, settings and results of its own, but no questions - they and their
  // images are stored once, on the original. Always the original itself, never
  // another copy, so there is one level to follow. Deleting the original moves
  // its question rows to its oldest copy and points the other copies at that
  // one first; the restrict below keeps anything else from leaving a copy with
  // nothing to show.
  questionSourceId   String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  collection     TestCollectionVisibility? @relation(fields: [collectionCategory], references: [category], onDelete: SetNull)
  questionSource Test?                     @relation("TestQuestionSource", fields: [questionSourceId], references: [id], onDelete: Restrict)
  questionCopies Test[]                    @relation("TestQuestionSource")
  questions      Question[]
  results        Result[]
  codeUnlocks    TestCodeUnlock[]

  @@index([createdAt])
  @@index([collectionCategory])
  @@index([visible])
  @@index([questionSourceId])
}

model TestCollectionVisibility {
  category  String   @id
  label     String?
  description String?
  position  Int      @default(0)
  visible   Boolean  @default(true)
  maxAttempts Int    @default(10)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tests     Test[]
  sectionAccesses SectionAccess[]
}

model SectionAccess {
  id          String   @id @default(uuid())
  email       String
  userId      String?
  category    String
  expiresAt   DateTime?
  note        String?
  grantedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  collection  TestCollectionVisibility @relation(fields: [category], references: [category], onDelete: Cascade)

  @@unique([email, category])
  @@index([userId])
  @@index([category])
  @@index([expiresAt])
}

// One row per student per code-protected test. It remembers which code the
// student entered, and counts wrong guesses so six digits cannot be brute-forced.
model TestCodeUnlock {
  id             String    @id @default(uuid())
  userId         String
  testId         String
  // The code that was accepted. The test is unlocked only while this still
  // equals Test.accessCode, so changing the code locks everyone out again.
  // Null until the first correct entry.
  code           String?
  failedAttempts Int       @default(0)
  lastFailedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  test           Test      @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([userId, testId])
  @@index([testId])
}

model Question {
  id            String   @id @default(uuid())
  testId        String
  content       String   // The reading passage or question text
  options       Json     // e.g., ["A", "B", "C", "D"] mapping
  correctAnswer String   // e.g., "A"
  explanation   String?  // Text explanation
  videoUrl      String?  // YouTube/Vimeo iframe URL
  imageUrl      String?  // Local path to image
  order         Int      // Question order in the test
  moduleIndex   Int      @default(1) // 1-based module this question belongs to
  // The bank question this one shows, when the test was imported or built
  // after the bank existed. Null for older tests. See BankQuestion.
  bankQuestionId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  test          Test     @relation(fields: [testId], references: [id])
  bankQuestion  BankQuestion? @relation(fields: [bankQuestionId], references: [id], onDelete: SetNull)

  @@index([testId, order])
  @@index([testId, moduleIndex, order])
  @@index([bankQuestionId])
}

// The question bank: every question imported or written since it exists,
// tagged by the SAT Math domain and a difficulty, independent of any test.
//
// A test still shows its own Question rows, so the exam, grading, review and
// stats read questions exactly as before. A row taken from the bank carries
// `bankQuestionId` and a copy of the bank text: deleting the test deletes the
// row, never the bank question, and an edit to either side is written through
// to the bank and every row linked to it (src/lib/questionBank.ts).
model BankQuestion {
  id            String   @id @default(uuid())
  content       String
  options       Json     // answer choices; empty for a grid-in question
  correctAnswer String
  imageUrl      String?
  // "algebra" | "advanced-math" | "problem-solving" | "geometry-trig"
  // (src/lib/questionBank.ts). Null only for a question not sorted yet.
  domain        String?
  difficulty    Int?     // 1 easy, 2 medium, 3 hard
  // Where it came from, for the admin: the .tex file name or the test title.
  source        String?
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  questions     Question[]

  @@index([domain, difficulty])
  @@index([createdAt])
}

model Result {
  id          String   @id @default(uuid())
  userId      String
  testId      String
  score       Int
  // How many questions were answered correctly. `score` cannot stand in for it:
  // it is a SAT-scale estimate rounded through a 44-question reference, so on a
  // test of any other length two different counts can land on the same score.
  // Null on rows written before the column existed and never backfilled.
  //
  // Fractional, because a multi-select question is graded for partial credit: a
  // student who picks one of two correct options and nothing wrong has answered
  // half a question, and rounding that to an integer would either hand them a
  // whole one or take it all away.
  correctCount Float?
  timeSpent   Int      // Time spent in seconds
  answers     Json     // User's selected answers
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id])
  test        Test     @relation(fields: [testId], references: [id])

  @@index([userId])
  @@index([userId, createdAt])
  // Serves result.count({ where: { userId, testId } }) on the exam page and in
  // examSubmission, plus groupBy(['testId']) on the dashboard. Without it the
  // planner has to BitmapAnd Result_testId_idx with Result_userId_createdAt_idx.
  @@index([userId, testId])
  @@index([testId])
}

model Subscription {
  id                     String   @id @default(uuid())
  userId                 String
  planId                 String
  isActive               Boolean  @default(true)
  expiresAt              DateTime
  provider               String   @default("MANUAL")
  providerSubscriptionId String?  @unique
  providerCustomerId     String?
  providerStatus         String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user                   User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, isActive, expiresAt])
}

model SubscriptionSetting {
  id         String   @id @default("global")
  isEnabled  Boolean  @default(true)
  cardHolder String   @default("Abdunazarov Mardon")
  cardNumber String   @default("9860 1201 0243 8112")
  cardType   String   @default("HUMO")
  amount     Int      @default(119000)
  updatedAt  DateTime @updatedAt
}

model Payment {
  id            String   @id @default(uuid())
  userId        String
  amount        Int      // in tiyin/cents
  currency      String   @default("UZS")
  provider      String   // e.g. "MANUAL_TRANSFER" or "MOCK"
  transactionId String?  @unique
  status        String   // "PENDING", "SUCCESS", "FAILED"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id])

  // `transactionId @unique` already creates Payment_transactionId_key; a second
  // plain index on the same column was a pure duplicate and has been removed.
  @@index([userId])
}

model ManualPaymentRequest {
  id               String   @id @default(uuid())
  userId           String
  amount           Int
  currency         String   @default("UZS")
  status           String   @default("PENDING")
  payerName        String?
  contact          String?
  paymentReference String?
  receiptPath      String?
  receiptFileName  String?
  receiptMimeType  String?
  message          String?
  adminNote        String?
  reviewedById     String?
  reviewedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id])

  @@index([userId])
  // /admin/payments orders by status ASC, createdAt DESC. With both columns ASC
  // the planner can only use this as a presorted prefix and still runs an
  // Incremental Sort; matching the DESC direction removes the sort node.
  @@index([status, createdAt(sort: Desc)])
}
